# Copy this file to .env and fill in your real values.
# Do NOT commit .env to source control.

# Neo4j
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional OCR/Parsing providers
LLMWHISPERER_API_KEY=
MISTRAL_API_KEY=

# NVIDIA LLM API
NVIDIA_API_KEY=
